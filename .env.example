# Application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://continuitygrid:continuitygrid_dev@localhost:5432/continuitygrid?schema=public

# Optional integrations (not required for the API foundation)
REDIS_URL=redis://localhost:6379

# Generate a unique random secret of at least 32 characters; never commit real secrets.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=cg_refresh
# Set true when served over HTTPS.
COOKIE_SECURE=false

# Optional fictional demo tenant seed (never enabled by default; prohibited in production)
DEMO_SEED_ENABLED=false
DEMO_ORGANIZATION_SLUG=continuitygrid-demo
DEMO_ADMIN_EMAIL=admin@continuitygrid.local
# Supply a unique password of at least 16 characters when explicitly enabling the demo seed.
DEMO_ADMIN_PASSWORD=
