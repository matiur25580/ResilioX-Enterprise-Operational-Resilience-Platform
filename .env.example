# Application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://continuitygrid:continuitygrid_dev@localhost:5432/continuitygrid?schema=public

# Optional integrations (not required for the API foundation)
REDIS_URL=redis://localhost:6379

# Set only in local development. Use a strong secret from a secret manager in deployed environments.
# AUTH_TOKEN_SECRET is intentionally not consumed until Milestone 03.
