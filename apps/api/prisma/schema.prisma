generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  OWNER
  ADMIN
  RESILIENCE_MANAGER
  ANALYST
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BusinessServiceStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  RETIRED
}

enum DependencyNodeType {
  BUSINESS_SERVICE
  BUSINESS_PROCESS
  APPLICATION
  TECHNOLOGY_ASSET
  SUPPLIER
}

enum DependencyType {
  SUPPORTS
  HOSTED_ON
  DEPENDS_ON
  PROVIDED_BY
  OPERATES_FROM
  PROCESSED_BY
}

enum DependencyStatus {
  PROPOSED
  VERIFIED
  DISPUTED
  RETIRED
}

enum CriticalityTier {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum BiaStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  TREATING
  ACCEPTED
  CLOSED
}

enum ControlStatus {
  DESIGN
  IMPLEMENTED
  TESTED
  NEEDS_REMEDIATION
}

enum RiskTreatmentStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum RiskTargetType {
  BUSINESS_SERVICE
  BUSINESS_PROCESS
  APPLICATION
  TECHNOLOGY_ASSET
  SUPPLIER
  DEPENDENCY
}

enum ContinuityPlanStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}
enum ContinuityExerciseType {
  TABLETOP
  WALKTHROUGH
  SIMULATION
  FULL_SCALE
}
enum ContinuityExerciseStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum ContinuityExerciseResult {
  SUCCESS
  PARTIAL_FAILURE
  FAILURE
}
enum ContinuityActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
}
enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  DETECTED
  TRIAGED
  ACTIVE
  MITIGATING
  RESOLVED
  CLOSED
  CANCELLED
}

enum ContinuityActionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecoveryRunbookStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum RecoverySimulationStatus {
  PLANNED
  READY
  RUNNING
  COMPLETED
  BLOCKED
  CANCELLED
}

enum RecoveryStepStatus {
  PENDING
  READY
  IN_PROGRESS
  SUCCEEDED
  FAILED
  BLOCKED
  SKIPPED
}

enum ImpactHorizon {
  IMMEDIATE
  FOUR_HOURS
  TWENTY_FOUR_HOURS
  SEVENTY_TWO_HOURS
  ONE_WEEK
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(160)
  slug        String             @unique @db.VarChar(80)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  memberships Membership[]
  auditEvents AuditEvent[]
  services    BusinessService[]
  processes   BusinessProcess[]
  applications Application[]
  assets      TechnologyAsset[]
  suppliers   Supplier[]
  dependencies Dependency[]
  biaAssessments BusinessImpactAssessment[]
  risks Risk[]
  controls Control[]
  continuityPlans ContinuityPlan[]
  incidents Incident[]
  recoveryRunbooks RecoveryRunbook[]
  recoverySimulations RecoverySimulation[]

  @@index([status])
  @@map("organizations")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(254)
  displayName  String       @map("display_name") @db.VarChar(120)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  sessions     RefreshSession[]
  auditEvents  AuditEvent[]
  recoveryApprovals RecoveryRunbook[] @relation("RecoveryRunbookApprover")
  recoveryRunbooksAuthored RecoveryRunbook[] @relation("RecoveryRunbookAuthor")

  @@index([displayName])
  @@map("users")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  role           TenantRole       @default(VIEWER)
  joinedAt       DateTime?        @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("memberships")
}

model BusinessService {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(180)
  description    String?              @db.Text
  ownerName      String?              @map("owner_name") @db.VarChar(120)
  criticality    CriticalityTier      @default(MEDIUM)
  status         BusinessServiceStatus @default(DRAFT)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  continuityPlans ContinuityPlan[]
  recoveryRunbooks RecoveryRunbook[]

  @@unique([organizationId, name])
  @@index([organizationId, status, criticality])
  @@map("business_services")
}

model BusinessProcess {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(180)
  description    String?      @db.Text
  ownerName      String?      @map("owner_name") @db.VarChar(120)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  biaAssessments BusinessImpactAssessment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_processes")
}

model Application {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(180)
  description    String?      @db.Text
  vendor         String?      @db.VarChar(120)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("applications")
}

model TechnologyAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(180)
  assetType      String       @map("asset_type") @db.VarChar(80)
  environment    String?      @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId, assetType])
  @@map("technology_assets")
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(180)
  website        String?      @db.VarChar(255)
  contactEmail   String?      @map("contact_email") @db.VarChar(254)
  criticality    CriticalityTier @default(MEDIUM)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId, criticality])
  @@map("suppliers")
}

model Dependency {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  sourceType     DependencyNodeType @map("source_type")
  sourceId       String           @map("source_id") @db.Uuid
  targetType     DependencyNodeType @map("target_type")
  targetId       String           @map("target_id") @db.Uuid
  type           DependencyType
  status         DependencyStatus @default(PROPOSED)
  criticality    CriticalityTier  @default(MEDIUM)
  confidence     Int              @default(50)
  verifiedAt     DateTime?        @map("verified_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, targetType, targetId])
  @@index([organizationId, status, criticality])
  @@unique([organizationId, sourceType, sourceId, targetType, targetId, type], map: "dependencies_tenant_edge_type_key")
  @@map("dependencies")
}


model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  familyId    String    @map("family_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by") @db.Uuid
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(120)
  targetType     String?  @map("target_type") @db.VarChar(80)
  targetId       String?  @map("target_id") @db.VarChar(120)
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}


model BusinessImpactAssessment {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  processId        String       @map("process_id") @db.Uuid
  version          Int          @default(1)
  status           BiaStatus    @default(DRAFT)
  ownerName        String       @map("owner_name") @db.VarChar(120)
  mtpdMinutes      Int          @map("mtpd_minutes")
  rtoMinutes       Int          @map("rto_minutes")
  rpoMinutes       Int          @map("rpo_minutes")
  rationale        String       @db.Text
  criticality      CriticalityTier @default(MEDIUM)
  impactScore      Int          @map("impact_score")
  reviewDueAt      DateTime?    @map("review_due_at")
  submittedAt      DateTime?    @map("submitted_at")
  approvedAt       DateTime?    @map("approved_at")
  approvedBy       String?      @map("approved_by") @db.VarChar(120)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  process          BusinessProcess @relation(fields: [processId], references: [id], onDelete: Restrict)
  impacts          BiaImpactSnapshot[]

  @@unique([organizationId, processId, version])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, criticality])
  @@map("business_impact_assessments")
}

model BiaImpactSnapshot {
  id              String        @id @default(uuid()) @db.Uuid
  assessmentId    String        @map("assessment_id") @db.Uuid
  horizon         ImpactHorizon
  financial       Int
  operational     Int
  regulatory      Int
  reputational    Int
  createdAt       DateTime      @default(now()) @map("created_at")
  assessment      BusinessImpactAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, horizon])
  @@map("bia_impact_snapshots")
}

model Risk {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  title String @db.VarChar(180)
  description String @db.Text
  category String @db.VarChar(80)
  ownerName String @map("owner_name") @db.VarChar(120)
  targetType RiskTargetType? @map("target_type")
  targetId String? @map("target_id") @db.Uuid
  likelihood Int
  impact Int
  inherentScore Int @map("inherent_score")
  residualScore Int @map("residual_score")
  status RiskStatus @default(IDENTIFIED)
  reviewDueAt DateTime? @map("review_due_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  controls RiskControl[]
  treatments RiskTreatment[]
  @@index([organizationId, status, residualScore])
  @@index([organizationId, targetType, targetId])
  @@map("risks")
}

model Control {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(180)
  description String @db.Text
  controlType String @map("control_type") @db.VarChar(60)
  ownerName String @map("owner_name") @db.VarChar(120)
  frequency String @db.VarChar(60)
  status ControlStatus @default(DESIGN)
  lastTestedAt DateTime? @map("last_tested_at")
  testEvidence String? @map("test_evidence") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  risks RiskControl[]
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("controls")
}

model RiskControl {
  id String @id @default(uuid()) @db.Uuid
  riskId String @map("risk_id") @db.Uuid
  controlId String @map("control_id") @db.Uuid
  effectiveness Int @default(0)
  lastTestedAt DateTime? @map("last_tested_at")
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  @@unique([riskId, controlId])
  @@index([controlId])
  @@map("risk_controls")
}

model RiskTreatment {
  id String @id @default(uuid()) @db.Uuid
  riskId String @map("risk_id") @db.Uuid
  title String @db.VarChar(180)
  ownerName String @map("owner_name") @db.VarChar(120)
  dueAt DateTime @map("due_at")
  status RiskTreatmentStatus @default(OPEN)
  notes String? @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  @@index([riskId, status, dueAt])
  @@map("risk_treatments")
}

model ContinuityPlan {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  version Int @default(1)
  title String @db.VarChar(180)
  ownerName String @map("owner_name") @db.VarChar(120)
  scope String @db.Text
  activationCriteria String @map("activation_criteria") @db.Text
  recoveryStrategy String @map("recovery_strategy") @db.Text
  recoveryProcedures String @map("recovery_procedures") @db.Text
  communicationsPlan String @map("communications_plan") @db.Text
  rtoMinutes Int @map("rto_minutes")
  rpoMinutes Int @map("rpo_minutes")
  status ContinuityPlanStatus @default(DRAFT)
  reviewDueAt DateTime? @map("review_due_at")
  submittedAt DateTime? @map("submitted_at")
  submittedBy String? @map("submitted_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  approvedBy String? @map("approved_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service BusinessService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  exercises ContinuityExercise[]
  recoveryRunbooks RecoveryRunbook[]
  @@unique([organizationId, serviceId, version])
  @@index([organizationId, status, reviewDueAt])
  @@index([serviceId, updatedAt])
  @@map("continuity_plans")
}

model ContinuityExercise {
  id String @id @default(uuid()) @db.Uuid
  planId String @map("plan_id") @db.Uuid
  exerciseType ContinuityExerciseType @map("exercise_type")
  title String @db.VarChar(180)
  scenario String @db.Text
  objectives String @db.Text
  scheduledAt DateTime @map("scheduled_at")
  status ContinuityExerciseStatus @default(PLANNED)
  result ContinuityExerciseResult?
  findings String? @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  plan ContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actions ContinuityAction[]
  @@index([planId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("continuity_exercises")
}

model ContinuityAction {
  id String @id @default(uuid()) @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  title String @db.VarChar(180)
  ownerName String @map("owner_name") @db.VarChar(120)
  severity ContinuityActionSeverity @default(MEDIUM)
  dueAt DateTime @map("due_at")
  status ContinuityActionStatus @default(OPEN)
  notes String? @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  exercise ContinuityExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@index([exerciseId, status, dueAt])
  @@map("continuity_actions")
}


model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  reference      String           @db.VarChar(24)
  title          String           @db.VarChar(180)
  description    String           @db.Text
  category       String           @db.VarChar(80)
  source         String           @db.VarChar(80)
  severity       IncidentSeverity @default(SEV3)
  status         IncidentStatus   @default(DETECTED)
  commanderName  String           @map("commander_name") @db.VarChar(120)
  detectedAt     DateTime         @default(now()) @map("detected_at")
  acknowledgedAt DateTime?        @map("acknowledged_at")
  resolvedAt     DateTime?        @map("resolved_at")
  closedAt       DateTime?        @map("closed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events         IncidentEvent[]
  tasks          IncidentTask[]
  recoverySimulations RecoverySimulation[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, severity, detectedAt])
  @@index([organizationId, updatedAt])
  @@map("incidents")
}

model IncidentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  message     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

model IncidentTask {
  id          String                @id @default(uuid()) @db.Uuid
  incidentId  String                @map("incident_id") @db.Uuid
  title       String                @db.VarChar(180)
  ownerName   String                @map("owner_name") @db.VarChar(120)
  priority    IncidentSeverity      @default(SEV3)
  status      ContinuityActionStatus @default(OPEN)
  dueAt       DateTime              @map("due_at")
  completedAt DateTime?             @map("completed_at")
  notes       String?               @db.Text
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  incident    Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, status, dueAt])
  @@map("incident_tasks")
}

model RecoveryRunbook {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  continuityPlanId String? @map("continuity_plan_id") @db.Uuid
  version Int @default(1)
  status RecoveryRunbookStatus @default(DRAFT)
  title String @db.VarChar(180)
  description String @db.Text
  ownerName String @map("owner_name") @db.VarChar(120)
  rtoMinutes Int? @map("rto_minutes")
  rpoMinutes Int? @map("rpo_minutes")
  reviewDueAt DateTime? @map("review_due_at")
  submittedAt DateTime? @map("submitted_at")
  approvedAt DateTime? @map("approved_at")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  approvedByUserId String? @map("approved_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service BusinessService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  continuityPlan ContinuityPlan? @relation(fields: [continuityPlanId], references: [id], onDelete: Restrict)
  createdBy User @relation("RecoveryRunbookAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("RecoveryRunbookApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  steps RecoveryRunbookStep[]
  simulations RecoverySimulation[]
  @@unique([organizationId, serviceId, title, version])
  @@index([organizationId, status, updatedAt])
  @@index([serviceId, status])
  @@map("recovery_runbooks")
}

model RecoveryRunbookStep {
  id String @id @default(uuid()) @db.Uuid
  runbookId String @map("runbook_id") @db.Uuid
  sequence Int
  title String @db.VarChar(180)
  description String @db.Text
  responsibleRole String @map("responsible_role") @db.VarChar(100)
  estimatedMinutes Int @map("estimated_minutes")
  validationCriteria String @map("validation_criteria") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  runbook RecoveryRunbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  predecessors RecoveryStepDependency[] @relation("RecoveryStepSuccessor")
  successors RecoveryStepDependency[] @relation("RecoveryStepPredecessor")
  simulationSteps RecoverySimulationStep[]
  @@unique([runbookId, sequence])
  @@index([runbookId])
  @@map("recovery_runbook_steps")
}

model RecoveryStepDependency {
  id String @id @default(uuid()) @db.Uuid
  predecessorStepId String @map("predecessor_step_id") @db.Uuid
  successorStepId String @map("successor_step_id") @db.Uuid
  predecessor RecoveryRunbookStep @relation("RecoveryStepPredecessor", fields: [predecessorStepId], references: [id], onDelete: Cascade)
  successor RecoveryRunbookStep @relation("RecoveryStepSuccessor", fields: [successorStepId], references: [id], onDelete: Cascade)
  @@unique([predecessorStepId, successorStepId])
  @@index([successorStepId])
  @@map("recovery_step_dependencies")
}

model RecoverySimulation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  runbookId String @map("runbook_id") @db.Uuid
  incidentId String? @map("incident_id") @db.Uuid
  runbookVersion Int @map("runbook_version")
  status RecoverySimulationStatus @default(PLANNED)
  targetRtoMinutes Int? @map("target_rto_minutes")
  targetRpoMinutes Int? @map("target_rpo_minutes")
  simulatedElapsedMinutes Int? @map("simulated_elapsed_minutes")
  dataLossAssumptionMinutes Int? @map("data_loss_assumption_minutes")
  dependencySnapshot Json? @map("dependency_snapshot")
  summary String? @db.Text
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  runbook RecoveryRunbook @relation(fields: [runbookId], references: [id], onDelete: Restrict)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  steps RecoverySimulationStep[]
  events RecoveryEvent[]
  @@index([organizationId, status, createdAt])
  @@index([runbookId, createdAt])
  @@index([incidentId])
  @@map("recovery_simulations")
}

model RecoverySimulationStep {
  id String @id @default(uuid()) @db.Uuid
  simulationId String @map("simulation_id") @db.Uuid
  runbookStepId String @map("runbook_step_id") @db.Uuid
  status RecoveryStepStatus @default(PENDING)
  operatorName String? @map("operator_name") @db.VarChar(120)
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  outcome String? @db.Text
  rationale String? @db.Text
  evidenceReference String? @map("evidence_reference") @db.VarChar(500)
  waiverRationale String? @map("waiver_rationale") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  simulation RecoverySimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  runbookStep RecoveryRunbookStep @relation(fields: [runbookStepId], references: [id], onDelete: Restrict)
  @@unique([simulationId, runbookStepId])
  @@index([simulationId, status])
  @@map("recovery_simulation_steps")
}

model RecoveryEvent {
  id String @id @default(uuid()) @db.Uuid
  simulationId String @map("simulation_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(80)
  message String @db.Text
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  simulation RecoverySimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  @@index([simulationId, createdAt])
  @@map("recovery_events")
}
