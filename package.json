{
  "name": "continuitygrid",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise operational resilience and business continuity platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @continuitygrid/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @continuitygrid/api",
    "db:migrate": "npm run db:migrate --workspace @continuitygrid/api",
    "db:deploy": "npm run db:deploy --workspace @continuitygrid/api",
    "db:seed": "npm run db:seed --workspace @continuitygrid/api",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}